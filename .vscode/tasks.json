{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build app in debug",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/build_debug.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
